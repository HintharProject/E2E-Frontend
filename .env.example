# ==== BACKEND API URL ====
# This is the default API URL used when running `npm run dev`
# To run with the deployed backend, use `npm run dev:remote`
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Clerk configuration (Get these from your Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
CLERK_SECRET_KEY=

# ==== MOCK DATA MODE ====
# Set to "true" or "1" to bypass Clerk authentication (for local UI development).
# When false or unset (default), real Clerk authentication is enforced.
# USE_MOCK_DATA=true

# ==== DIRECT B2 UPLOADS CORS REMINDER ====
# If hosting the frontend on a custom port or domain, ensure the origin is registered
# in backend CORS_ALLOWED_ORIGINS and run `python manage.py configure_b2_cors`

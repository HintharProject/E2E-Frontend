# E2E frontend — environment template
# Copy to `.env`. Do not commit `.env`.

# ---------------------------------------------------------------------------
# Mock mode (default) — no API backend, no database, no Clerk required
# ---------------------------------------------------------------------------
USE_MOCK_DATA=true

# Change CURRENT_USER_ID in src/lib/mock-data.ts to preview Student/Creator/Admin.

# ---------------------------------------------------------------------------
# Live mode — set USE_MOCK_DATA=false and fill in the sections below
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# NEXT_PUBLIC_API_BASE_URL=https://e2e-backend-4t9p.onrender.com
# ALLOW_CLERK_AUTH_FALLBACK=true

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=
# CLERK_SECRET_KEY=
